# 실행 환경 표시 — 운영은 production, 테스트 서버는 development
NEXT_PUBLIC_APP_ENV=development

# 공개 가능한 Supabase 연결값
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 비밀값 — NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# Meta Marketing API — 무료클래스 캠페인 광고 실적 동기화 전용 서버 값입니다.
# 지원 중인 Graph API 버전을 명시하고, Preview/Production 토큰을 분리하세요.
META_GRAPH_API_VERSION=
META_ACCESS_TOKEN=

# 토스페이먼츠 API 개별 연동 키입니다.
# 클라이언트 키만 브라우저에 노출할 수 있습니다. 시크릿 키에는 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 테스트 결제는 test_ck_ / test_sk_, 실제 결제는 live_ck_ / live_sk_ 키를 같은 환경에 한 쌍으로 설정하세요.
# Vercel에서는 Preview와 Production 환경변수를 각각 설정한 뒤 반드시 재배포해야 반영됩니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 실결제 환불은 기본 차단. 운영자 승인 후에만 true로 변경하고 재배포하세요.
# test_sk_ 테스트 키는 이 설정 없이 테스트 환불을 사용할 수 있습니다.
EDU_ALLOW_LIVE_REFUNDS=false

# 웹훅 URL에 query parameter로 함께 등록할 임의의 긴 값입니다.
# 예: https://example.com/api/payments/toss/webhook?token=...
TOSS_WEBHOOK_TOKEN=

# CRM / SOLAPI — 모두 서버 전용 값입니다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
SOLAPI_OPTOUT_PHONE=
SOLAPI_KAKAO_PF_ID=
CRM_DELIVERY_ENABLED=false
CRM_AUTOMATIONS_ENABLED=false
CRM_TEST_RECIPIENT_PHONE=

# 전환 관리 초기 검수 — migration 적용 후 개발 환경에서만 활성화하세요.
EDU_CONVERSION_REVIEW_ENABLED=false
# 모의 판단은 명시적인 비운영 환경에서만 실행됩니다. 외부 모델을 호출하지 않습니다.
EDU_CONVERSION_MOCK_ENABLED=false
# 실제 Jev 판정도 초기에는 명시적인 비운영 환경에서만 그림자 모드로 실행됩니다.
TYPESAFE_API_KEY=
EDU_CONVERSION_JEV_ENABLED=false

# Vercel Cron 요청을 검증할 임의의 긴 값입니다.
CRON_SECRET=
