{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.brandyaction.invalid/edu/2.0.0-rc.2/schema.json",
  "title": "EDU personal export candidate — NOT DEPLOYED",
  "$defs": {
    "PaymentPayload": {
      "type": "object",
      "properties": {
        "consent_epoch": {
          "type": "string",
          "pattern": "^ce_[A-Za-z0-9_-]{32}$"
        },
        "consent_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:_-]{0,79}$"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "order_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "payment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "cohort_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,79}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_paid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currency": {
          "const": "KRW"
        },
        "entry_src": {
          "enum": [
            "paid",
            "organic",
            "alumni",
            "youtube",
            "unknown"
          ]
        },
        "attribution_def": {
          "const": "path_cohort@1"
        }
      },
      "required": [
        "consent_epoch",
        "consent_version",
        "record_revision",
        "expires_at",
        "order_id",
        "payment_id",
        "cohort_code",
        "amount_paid",
        "currency",
        "entry_src",
        "attribution_def"
      ],
      "additionalProperties": false
    },
    "RefundPayload": {
      "type": "object",
      "properties": {
        "consent_epoch": {
          "type": "string",
          "pattern": "^ce_[A-Za-z0-9_-]{32}$"
