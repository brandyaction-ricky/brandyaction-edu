              "type": "string",
              "pattern": "^(ev|lu|ts|rc)_[A-Za-z0-9_-]{20,512}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "tenant_id",
        "brand_id",
        "contract_version",
        "generated_at",
        "stream_generation",
        "snapshot_upper",
        "next_cursor",
