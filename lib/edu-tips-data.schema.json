        },
        "order_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "payment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "refund_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "cohort_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,79}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_refunded": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currency": {
          "const": "KRW"
        },
        "original_payment_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "attribution_def": {
          "const": "path_cohort@1"
        }
      },
      "required": [
        "consent_epoch",
        "consent_version",
        "record_revision",
        "expires_at",
        "order_id",
        "payment_id",
        "refund_id",
        "cohort_code",
        "amount_refunded",
        "currency",
        "original_payment_at",
        "attribution_def"
      ],
      "additionalProperties": false
    },
    "PaymentEvent": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "tenant_id": {
          "const": "brandyaction"
        },
        "brand_id": {
          "const": "brandyaction_edu"
        },
        "event_timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "T[0-2][0-9]:00:00(?:\\.000)?Z$"
        },
        "source": {
          "const": "server"
        },
        "schema_version": {
          "const": "1.4"
        },
        "customer_id": {
          "type": "string",
          "pattern": "^k[1-9][0-9]*:[A-Za-z0-9_-]{43}$"
        },
        "product_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,79}$"
        },
        "session_id": {
          "const": null
        },
        "event_type": {
          "const": "payment_completed"
        },
        "payload": {
          "$ref": "#/$defs/PaymentPayload"
        }
      },
      "required": [
        "event_id",
        "tenant_id",
        "brand_id",
        "event_timestamp",
        "source",
        "schema_version",
        "customer_id",
        "product_id",
        "session_id",
        "event_type",
        "payload"
      ],
      "additionalProperties": false
    },
    "RefundEvent": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "tenant_id": {
          "const": "brandyaction"
        },
        "brand_id": {
          "const": "brandyaction_edu"
        },
        "event_timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "T[0-2][0-9]:00:00(?:\\.000)?Z$"
        },
        "source": {
          "const": "server"
        },
        "schema_version": {
          "const": "1.4"
        },
        "customer_id": {
          "type": "string",
          "pattern": "^k[1-9][0-9]*:[A-Za-z0-9_-]{43}$"
        },
        "product_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,79}$"
        },
        "session_id": {
          "const": null
        },
        "event_type": {
          "const": "order_refunded"
        },
        "payload": {
          "$ref": "#/$defs/RefundPayload"
        }
      },
      "required": [
        "event_id",
        "tenant_id",
        "brand_id",
        "event_timestamp",
        "source",
        "schema_version",
        "customer_id",
        "product_id",
        "session_id",
        "event_type",
        "payload"
      ],
      "additionalProperties": false
    },
    "Event": {
      "oneOf": [
        {
          "$ref": "#/$defs/PaymentEvent"
        },
        {
          "$ref": "#/$defs/RefundEvent"
        }
      ]
    },
    "LearningRow": {
      "type": "object",
      "properties": {
        "consent_epoch": {
          "type": "string",
          "pattern": "^ce_[A-Za-z0-9_-]{32}$"
        },
        "consent_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:_-]{0,79}$"
        },
        "record_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "customer_id": {
          "type": "string",
          "pattern": "^k[1-9][0-9]*:[A-Za-z0-9_-]{43}$"
        },
        "product_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,79}$"
        },
        "cohort_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,79}$"
        },
        "date_kst": {
          "type": "string",
          "format": "date"
        },
        "vod_completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resource_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "live_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "replay_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completed_items": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "total_items": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "curriculum_version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9:_-]{0,79}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "enum": [
            "available",
            "not_available",
            "unknown"
          ]
        },
        "cohort_state": {
          "enum": [
            "before_start",
            "active",
            "alumni",
            "paused",
            "unknown"
          ]
        },
        "usage_ratio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "consent_epoch",
        "consent_version",
        "record_revision",
        "expires_at",
        "record_id",
        "customer_id",
        "product_id",
        "cohort_code",
        "date_kst",
        "vod_completed",
        "resource_used",
        "live_used",
        "replay_used",
        "completed_items",
        "total_items",
        "curriculum_version",
        "availability",
        "cohort_state",
        "usage_ratio"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "completed_items": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "total_items": {
                    "enum": [
                      null,
                      0
                    ]
                  }
                }
              },
              {
                "properties": {
                  "curriculum_version": {
                    "type": "null"
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "usage_ratio": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "EventPage": {
      "type": "object",
      "properties": {
        "source": {
          "const": "brandyaction_edu"
        },
        "tenant_id": {
