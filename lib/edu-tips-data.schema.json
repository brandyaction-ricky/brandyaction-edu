    "Tombstone": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "customer_id": {
          "type": "string",
          "pattern": "^k[1-9][0-9]*:[A-Za-z0-9_-]{43}$"
        },
        "consent_epoch": {
          "type": "string",
          "pattern": "^ce_[A-Za-z0-9_-]{32}$"
        },
        "reason": {
          "enum": [
            "consent_withdrawn",
            "account_deleted",
            "identity_retired"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "cursor": {
          "type": "string",
          "pattern": "^(ev|lu|ts|rc)_[A-Za-z0-9_-]{20,512}$"
        },
        "active_due_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "Exactly 5 elapsed UTC days after original at; retries must not extend. Enforced by semantic validation, not date-time format alone."
        },
        "model_due_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "Exactly 30 elapsed UTC days after original at; retries must not extend. Enforced by semantic validation, not date-time format alone."
        },
        "residual_due_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "Exactly 30 elapsed UTC days after original at; retries must not extend. Enforced by semantic validation, not date-time format alone."
        }
      },
      "required": [
        "requestId",
        "customer_id",
        "consent_epoch",
        "reason",
        "at",
        "cursor",
        "active_due_at",
        "model_due_at",
        "residual_due_at"
      ],
      "additionalProperties": false
    },
